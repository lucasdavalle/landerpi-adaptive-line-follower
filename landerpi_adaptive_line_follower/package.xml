<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>landerpi_adaptive_line_follower</name>
  <version>0.1.0</version>
  <description>
    C++ adaptive line follower for LanderPi: estimates line curvature across
    three look-ahead camera bands to adapt linear speed, with a brief search
    recovery instead of a hard stop when the line is lost. Standalone C++
    upgrade of the stock line_following.py, independent of that node.
  </description>
  <maintainer email="lucasdavalle25@gmail.com">ldavalle</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>libopencv-dev</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>lifecycle_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>interfaces</depend>
  <depend>cv_bridge</depend>
  <depend>servo_controller_msgs</depend>

  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
